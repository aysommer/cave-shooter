# Copy to .env in the project root and fill in. Docker Compose reads it.

# Your domain (an A record pointing to the VPS). Caddy gets the HTTPS
# certificate for it. Local test: localhost
DOMAIN=game.example.com

# Public IP of the VPS (for coturn).
PUBLIC_IP=203.0.113.10

# Address coturn binds its relays to. Leave empty on a normal VPS (the
# public IP is on its network card). On clouds with NAT (AWS, GCP, Azure)
# set it to the machine's private IP (see: ip -4 addr).
RELAY_IP=

# Shared secret between the signal server (issues temporary TURN logins)
# and coturn. Generate: openssl rand -hex 32
TURN_SECRET=change-me

# Where the images come from (GitHub Container Registry of the repo owner)
# and which version. Leave as is unless you fork the project.
REGISTRY=ghcr.io/aysommer
TAG=latest

# ---- development only (docker-compose.dev.yml) ----
# Host the browsers use to reach coturn: localhost, or this machine's LAN IP.
TURN_HOST=localhost
# Address coturn relays from: 127.0.0.1 on one machine, the LAN IP otherwise.
TURN_RELAY_IP=127.0.0.1
