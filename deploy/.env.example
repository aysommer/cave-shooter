# Copy to .env in the project root and fill in.
# Docker Compose reads it automatically.

# Shared secret between the signal server (issues temporary TURN logins)
# and coturn. Generate one: openssl rand -hex 32
TURN_SECRET=change-me

# Host name or IP the browsers use to reach coturn.
#  dev on one machine: localhost
#  dev on a LAN:       the LAN IP of this machine, e.g. 192.168.1.10
#  production:         your domain, e.g. game.example.com
TURN_HOST=localhost

# Dev only: address coturn relays from. One machine: 127.0.0.1;
# LAN: this machine's LAN IP (same as TURN_HOST then).
TURN_RELAY_IP=127.0.0.1

# Production only (stage 10): public IP of the VPS running coturn.
PUBLIC_IP=203.0.113.10

# Production only (stage 10): domain for HTTPS certificates.
DOMAIN=game.example.com
